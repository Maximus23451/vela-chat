# Copy this file to `keystore.properties` (which is git-ignored) and fill in your
# real values to produce a signed release build. Alternatively, set the
# equivalent environment variables: VELA_KEYSTORE, VELA_STORE_PASSWORD,
# VELA_KEY_ALIAS, VELA_KEY_PASSWORD.
#
# If neither this file nor the env vars are present, the `release` variant falls
# back to debug signing so the build still succeeds (not suitable for store
# distribution, but installable for testing).
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore vela-release.jks -alias vela-key \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=vela-release.jks
storePassword=CHANGE_ME
keyAlias=vela-key
keyPassword=CHANGE_ME
